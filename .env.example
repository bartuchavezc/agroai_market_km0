# The AgroAI API (agroai_crops-agent-api). Its CORS_ORIGINS must include this app's origin.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Where producers manage their side (agroai_web-monitoring), linked from the header.
NEXT_PUBLIC_PRODUCER_APP_URL=http://localhost:3000
# Mapbox public token (pk.*), the same one agroai_web-monitoring uses. Without it the page falls back to the design's
# drawn map. Optional style (default mapbox/light-v11) or a whole tile URL template to use other tiles.
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_MAPBOX_STYLE=mapbox/light-v11
# NEXT_PUBLIC_MAP_TILES_URL=
# Where distances are measured from until the buyer shares their location (City Bell).
NEXT_PUBLIC_DEFAULT_LAT=-34.8712
NEXT_PUBLIC_DEFAULT_LNG=-58.0455
NEXT_PUBLIC_DEFAULT_PLACE=City Bell
