# The AgroAI API (agroai_crops-agent-api). Its CORS_ORIGINS must include this app's origin.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Where producers manage their side (agroai_web-monitoring), linked from the header.
NEXT_PUBLIC_PRODUCER_APP_URL=http://localhost:3000
# Mapbox public token (pk.*), the same one agroai_web-monitoring uses: the map and the address search need it.
# Optional style (default mapbox/light-v11), or a whole 256 px XYZ tile URL template to use other tiles.
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_MAPBOX_STYLE=mapbox/light-v11
# NEXT_PUBLIC_MAP_TILES_URL=
# Only the map's starting view while there are no farms and the buyer hasn't set their place (default: CABA).
# It is never used as anyone's location: distances appear once the buyer enters their address.
# NEXT_PUBLIC_MAP_CENTER_LAT=-34.6037
# NEXT_PUBLIC_MAP_CENTER_LNG=-58.3816
